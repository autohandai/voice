    "Edit the final text below. The pair is stored only as a pending suggestion and cannot change dictation until you confirm it in Vocabulary." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeiten Sie den endgültigen Text unten. Das Paar wird nur als ausstehender Vorschlag gespeichert und kann das Diktat erst dann ändern, wenn Sie es im Wortschatz bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
