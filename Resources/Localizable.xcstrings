    "Advanced metrics use bounded local counters. Voice view appears only from retained History after 2,000 words and labels its deterministic method." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterte Metriken verwenden begrenzte lokale Zähler. Die Sprachansicht erscheint erst ab dem gespeicherten Verlauf nach 2.000 Wörtern und weist auf die deterministische Methode hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced metrics use bounded local counters. Voice view appears only from retained History after 2,000 words and labels its deterministic method."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las métricas avanzadas utilizan contadores locales acotados. La vista de voz aparece solo a partir del Historial retenido después de 2000 palabras y etiqueta su método determinista."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le metriche avanzate utilizzano contatori locali limitati. La vista vocale appare solo dalla cronologia conservata dopo 2.000 parole ed etichetta il suo metodo deterministico."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Métricas avançadas usam contadores locais limitados. A visualização por voz aparece apenas no histórico retido após 2.000 palavras e rotula seu método determinístico."
          }
        }
      }
    },
    "Aggregate metrics appear after future dictations. Transcript text is never required." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
