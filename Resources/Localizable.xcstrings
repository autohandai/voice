    "Only the selected known model cache is removed. It must be prepared again before use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der ausgewählte Cache für bekannte Modelle wird entfernt. Es muss vor der Verwendung erneut vorbereitet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the selected known model cache is removed. It must be prepared again before use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se elimina la caché del modelo conocido seleccionado. Debe prepararse nuevamente antes de su uso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene rimossa solo la cache del modello noto selezionato. Deve essere preparato nuovamente prima dell'uso."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente o cache do modelo conhecido selecionado é removido. Deve ser preparado novamente antes de usar."
          }
        }
      }
    },
    "Only this model’s cache is replaced. Other models and user data are preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Cache dieses Modells wird ersetzt. Andere Modelle und Benutzerdaten bleiben erhalten."
          }
