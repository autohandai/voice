    "Autohand AI builds AI coding agents and governed software factories." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autohand AI baut KI-Codierungsagenten und verwaltete Softwarefabriken."
          }
        },
