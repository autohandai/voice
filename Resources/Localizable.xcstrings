    "Hold Fn for 0.4 seconds to start, then release to finish. Short presses keep their normal macOS behavior, and Control–Option–Space remains available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie Fn zum Starten 0,4 Sekunden lang gedrückt und lassen Sie es dann los, um den Vorgang zu beenden. Durch kurzes Drücken bleibt das normale macOS-Verhalten erhalten und Strg-Wahl-Leertaste bleibt verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Fn for 0.4 seconds to start, then release to finish. Short presses keep their normal macOS behavior, and Control–Option–Space remains available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga presionada la tecla Fn durante 0,4 segundos para comenzar y luego suéltela para finalizar. Las pulsaciones breves mantienen el comportamiento normal de macOS y Control-Opción-Espacio permanece disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto Fn per 0,4 secondi per iniziare, quindi rilascia per terminare. Le pressioni brevi mantengono il normale comportamento di macOS e Controllo–Opzione–Spazio rimane disponibile."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure Fn por 0,4 segundos para iniciar e solte para terminar. Pressões curtas mantêm seu comportamento normal do macOS e Control–Option–Space permanece disponível."
          }
        }
      }
    },
