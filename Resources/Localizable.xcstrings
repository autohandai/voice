    "%lld left" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld übrig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld left"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedan %lld"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld rimasti"
          }
        },
        "pt" : {
