    "Escape still cancels Hands-Free recording. A Commit shortcut sends Enter only during the brief verified window after a successful typed insertion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape bricht weiterhin die Freisprechaufnahme ab. Eine Commit-Verknüpfung sendet die Eingabetaste nur während des kurzen Überprüfungsfensters nach einer erfolgreichen eingegebenen Einfügung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape still cancels Hands-Free recording. A Commit shortcut sends Enter only during the brief verified window after a successful typed insertion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape aún cancela la grabación con manos libres. Un atajo de confirmación envía Enter solo durante la breve ventana verificada después de una inserción escrita exitosa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La funzione Escape annulla comunque la registrazione in vivavoce. Una scorciatoia di commit invia Invio solo durante la breve finestra verificata dopo un inserimento digitato con successo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape ainda cancela a gravação com viva-voz. Um atalho Commit envia Enter apenas durante a breve janela verificada após uma inserção digitada com sucesso."
          }
        }
      }
    },
