    "Autohand Voice is open source under the MIT License." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autohand Voice ist Open Source unter der MIT-Lizenz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autohand Voice is open source under the MIT License."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autohand Voice es de código abierto bajo la licencia MIT."
          }
        },
        "it" : {
