    "Profiles match exact bundle identifiers. No window title, document name, or app content is read. Any setting left on Use Global follows General." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile stimmen mit genauen Bundle-IDs überein. Es wird kein Fenstertitel, Dokumentname oder App-Inhalt gelesen. Alle Einstellungen, die auf „Global verwenden“ verbleiben, folgen „Allgemein“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiles match exact bundle identifiers. No window title, document name, or app content is read. Any setting left on Use Global follows General."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles coinciden exactamente con los identificadores de paquete. No se lee ningún título de ventana, nombre de documento ni contenido de la aplicación. Cualquier configuración que quede en Usar Global sigue a General."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili corrispondono agli identificatori esatti del bundle. Non viene letto il titolo della finestra, il nome del documento o il contenuto dell'app. Qualsiasi impostazione lasciata su Usa globale segue Generale."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis correspondem exatamente aos identificadores de pacote. Nenhum título de janela, nome de documento ou conteúdo de aplicativo é lido. Qualquer configuração deixada em Usar Global segue Geral."
          }
        }
      }
    },
