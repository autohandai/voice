    "macOS Dictation is on and can start when you press Fn twice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die macOS-Diktierfunktion ist aktiviert und kann starten, wenn Sie Fn zweimal drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS Dictation is on and can start when you press Fn twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Dictado de macOS está activado y puede iniciarse al presionar Fn dos veces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Dettatura di macOS è attiva e può avviarsi quando premi Fn due volte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Ditado do macOS está ativado e pode iniciar quando você pressiona Fn duas vezes."
