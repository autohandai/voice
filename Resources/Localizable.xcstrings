    "At rest, the first available route wins. During recording, an enabled handoff creates a bounded audio segment without restarting recognition or discarding earlier samples." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Ruhezustand gewinnt die erste verfügbare Route. Während der Aufnahme erstellt eine aktivierte Übergabe ein begrenztes Audiosegment, ohne die Erkennung neu zu starten oder frühere Samples zu verwerfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At rest, the first available route wins. During recording, an enabled handoff creates a bounded audio segment without restarting recognition or discarding earlier samples."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En reposo, gana la primera ruta disponible. Durante la grabación, una transferencia habilitada crea un segmento de audio delimitado sin reiniciar el reconocimiento ni descartar muestras anteriores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A riposo, vince il primo percorso disponibile. Durante la registrazione, un trasferimento abilitato crea un segmento audio delimitato senza riavviare il riconoscimento o scartare i campioni precedenti."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em repouso, a primeira rota disponível vence. Durante a gravação, uma transferência habilitada cria um segmento de áudio limitado sem reiniciar o reconhecimento ou descartar amostras anteriores."
          }
        }
      }
    },
    "Audio and transcript text stay on this Mac. No upload, cloud cleanup, translation, meeting capture, or speaker diarization is performed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio- und Transkripttext bleiben auf diesem Mac. Es wird kein Upload, keine Cloud-Bereinigung, Übersetzung, Besprechungsaufzeichnung oder Sprecheraufzeichnung durchgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio and transcript text stay on this Mac. No upload, cloud cleanup, translation, meeting capture, or speaker diarization is performed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio y la transcripción del texto permanecen en esta Mac. No se realizan cargas, limpieza de la nube, traducción, captura de reuniones ni registro de oradores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio e il testo della trascrizione rimangono su questo Mac. Non viene eseguito alcun caricamento, pulizia del cloud, traduzione, acquisizione della riunione o diarizzazione del relatore."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio e o texto transcrito permanecem neste Mac. Nenhum upload, limpeza de nuvem, tradução, captura de reunião ou diário de palestrante é realizado."
          }
        }
      }
    },
