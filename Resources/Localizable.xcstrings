    "A slim pill whose bars follow your voice. Hover it for cancel and stop. The live preview shows only in Classic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine schmale Leiste, deren Balken Ihrer Stimme folgen. Bewegen Sie den Zeiger darauf, um abzubrechen oder zu stoppen. Die Live-Vorschau gibt es nur in Klassisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A slim pill whose bars follow your voice. Hover it for cancel and stop. The live preview shows only in Classic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una píldora delgada cuyas barras siguen su voz. Pase el puntero por encima para cancelar o detener. La vista previa en vivo solo aparece en Clásico."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pillola sottile le cui barre seguono la tua voce. Passaci sopra il puntatore per annullare o fermare. L'anteprima dal vivo appare solo in Classico."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pílula fina cujas barras acompanham sua voz. Passe o ponteiro sobre ela para cancelar ou parar. A prévia ao vivo aparece apenas no Clássico."
          }
        }
      }
    },
