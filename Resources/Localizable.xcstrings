    "Say “command new line,” “command new paragraph,” “command comma,” “command period,” “command question mark,” “command scratch that,” “command literal mode,” or “command cancel dictation.” English only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagen Sie „Befehl Neue Zeile“, „Befehl Neuer Absatz“, „Befehl Komma“, „Befehl Punkt“, „Befehl Fragezeichen“, „Befehl Scratch That“, „Befehl Literalmodus“ oder „Befehl Abbrechen des Diktats“. Nur Englisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “command new line,” “command new paragraph,” “command comma,” “command period,” “command question mark,” “command scratch that,” “command literal mode,” or “command cancel dictation.” English only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga \"comando nueva línea\", \"comando nuevo párrafo\", \"comando comando\", \"comando período\", \"comando signo de interrogación\", \"comando tacha eso\", \"comando modo literal\" o \"comando cancelar dictado\". Sólo inglés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronuncia \"comando nuova riga\", \"comando nuovo paragrafo\", \"comando virgola\", \"comando punto\", \"comando punto interrogativo\", \"comando cancella quello\", \"comando modalità letterale\" o \"comando annulla dettatura\". Solo inglese."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “comando nova linha”, “comando novo parágrafo”, “comando vírgula”, “comando ponto final”, “comando ponto de interrogação”, “comando risque isso”, “comando modo literal” ou “comando cancelar ditado”. Somente inglês."
          }
        }
      }
    },
