    "Canadian spelling applies only during Light or Medium local cleanup. Literal transcripts and non-English languages are never rewritten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kanadische Schreibweise gilt nur während der lokalen Bereinigung „Light“ oder „Medium“. Wörtliche Transkripte und nicht-englische Sprachen werden niemals umgeschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canadian spelling applies only during Light or Medium local cleanup. Literal transcripts and non-English languages are never rewritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ortografía canadiense se aplica solo durante la limpieza local Ligera o Media. Las transcripciones literales y los idiomas distintos del inglés nunca se reescriben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ortografia canadese si applica solo durante la pulizia locale Leggera o Media. Le trascrizioni letterali e le lingue diverse dall'inglese non vengono mai riscritte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ortografia canadense se aplica somente durante a limpeza local Leve ou Média. Transcrições literais e idiomas diferentes do inglês nunca são reescritos."
          }
        }
      }
    },
