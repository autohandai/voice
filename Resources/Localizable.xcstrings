    "Matching is case-insensitive, uses whole words, and applies the longest phrase first. Replacements never call a remote service." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Matching wird die Groß-/Kleinschreibung nicht beachtet, es werden ganze Wörter verwendet und die längste Phrase wird zuerst angewendet. Für den Ersatz rufen Sie niemals einen Remote-Service an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matching is case-insensitive, uses whole words, and applies the longest phrase first. Replacements never call a remote service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coincidencia no distingue entre mayúsculas y minúsculas, utiliza palabras completas y aplica primero la frase más larga. Los reemplazos nunca llaman a un servicio remoto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La corrispondenza non fa distinzione tra maiuscole e minuscole, utilizza parole intere e applica per prima la frase più lunga. Le sostituzioni non chiamano mai un servizio remoto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A correspondência não diferencia maiúsculas de minúsculas, usa palavras inteiras e aplica a frase mais longa primeiro. As substituições nunca chamam um serviço remoto."
          }
        }
      }
    },
