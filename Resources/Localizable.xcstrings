        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica il testo finale qui sotto. La coppia viene memorizzata solo come suggerimento in sospeso e non può modificare la dettatura finché non la confermi nel Vocabolario."
          }
        },
        "pt" : {
          "stringUnit" : {
