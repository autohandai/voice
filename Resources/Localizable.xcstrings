    "Deletes preferences, History, vocabulary, app profiles, styles, insights, diagnostics, Scratchpad notes and assets, transform templates, encrypted recovery artifacts, and the Keychain recovery key. Local model files are not user content and remain installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Einstellungen, Verlauf, Vokabular, App-Profile, Stile, Einblicke, Diagnosen, Scratchpad-Notizen und -Assets, Transformationsvorlagen, verschlüsselte Wiederherstellungsartefakte und den Schlüsselbund-Wiederherstellungsschlüssel. Lokale Modelldateien sind kein Benutzerinhalt und bleiben installiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes preferences, History, vocabulary, app profiles, styles, insights, diagnostics, Scratchpad notes and assets, transform templates, encrypted recovery artifacts, and the Keychain recovery key. Local model files are not user content and remain installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina preferencias, historial, vocabulario, perfiles de aplicaciones, estilos, conocimientos, diagnósticos, notas y activos del Bloc de notas, plantillas de transformación, artefactos de recuperación cifrados y la clave de recuperación del llavero. Los archivos de modelos locales no son contenido del usuario y permanecen instalados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina preferenze, cronologia, vocabolario, profili delle app, stili, approfondimenti, diagnostica, note e risorse di Scratchpad, modelli di trasformazione, artefatti di ripristino crittografati e chiave di ripristino del portachiavi. I file del modello locale non sono contenuti dell'utente e rimangono installati."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui preferências, histórico, vocabulário, perfis de aplicativos, estilos, insights, diagnósticos, notas e ativos do Scratchpad, modelos de transformação, artefatos de recuperação criptografados e a chave de recuperação das chaves. Os arquivos de modelo local não são conteúdo do usuário e permanecem instalados."
          }
        }
      }
    },
